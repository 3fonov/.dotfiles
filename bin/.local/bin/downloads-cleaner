#!/bin/bash
# Remove files from Downloads that were both created and modified more than
# 3 weeks (21 days) ago, then remove any empty directories.

DOWNLOADS_DIR="$HOME/Downloads"
THREE_WEEKS_SECONDS=$((21 * 24 * 60 * 60))
CURRENT_TIME=$(date +%s)
THRESHOLD=$((CURRENT_TIME - THREE_WEEKS_SECONDS))

# Delete old files.
find "$DOWNLOADS_DIR" -type f | while IFS= read -r file; do
    creation_time=$(stat -f %B "$file")
    modification_time=$(stat -f %m "$file")

    if [ "$creation_time" -lt "$THRESHOLD" ] && [ "$modification_time" -lt "$THRESHOLD" ]; then
        echo "Deleting file: $file"
        rm "$file"
    fi
done

# Delete empty directories (deepest first), but never delete Downloads itself.
find "$DOWNLOADS_DIR" -depth -type d -empty ! -path "$DOWNLOADS_DIR" | while IFS= read -r dir; do
    echo "Deleting empty directory: $dir"
    rmdir "$dir"
done
